~ theme.wit — the design system for the Wit landing page. Exposed as
~ #stylesheet; the root emits it with @stylesheet.
~
~ Voice: editorial / university-press. Warm paper, a book serif for the
~ reading type, an oxblood accent. Built for academics who love how LaTeX
~ *looks* and are done fighting how it *feels*. Default light; ◑ toggles dark.

#stylesheet
@@style
:root {
  --bg: #f6f1e7;        /* warm paper */
  --surface: #fffcf5;   /* card stock */
  --surface-2: #efe7d6;
  --text: #221f1a;      /* ink */
  --muted: #6d6454;
  --accent: #8a2b39;    /* oxblood — university-press red */
  --accent-2: #b0563f;  /* rust, for warmth in the gradient */
  --border: #e4dbc8;
  --ring: rgba(138, 43, 57, 0.22);
  --serif: "Iowan Old Style", "Palatino Linotype", Palatino, "Book Antiqua",
           Georgia, Cambria, "Times New Roman", serif;
  --sans: "Inter", ui-sans-serif, system-ui, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  --mono: "JetBrains Mono", "SF Mono", ui-monospace, Menlo, Consolas, monospace;
}
:root.dark {
  --bg: #16130d;
  --surface: #201b13;
  --surface-2: #2a241a;
  --text: #ece4d4;
  --muted: #9a9080;
  --accent: #df909b;
  --accent-2: #e2a583;
  --border: #322b1f;
  --ring: rgba(223, 144, 155, 0.28);
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body { margin: 0; background: var(--bg); color: var(--text);
       font-family: var(--serif); line-height: 1.65; font-size: 18px;
       -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; }
h1, h2, h3 { font-weight: 700; letter-spacing: -0.01em; }
a { color: var(--accent); text-underline-offset: 3px; }
.wrap { max-width: 1060px; margin: 0 auto; padding: 0 1.5rem; }
.grad { background: linear-gradient(95deg, var(--accent), var(--accent-2));
        -webkit-background-clip: text; background-clip: text; color: transparent; }

/* nav */
.nav { position: sticky; top: 0; z-index: 20;
       background: color-mix(in srgb, var(--bg) 82%, transparent);
       backdrop-filter: blur(12px); border-bottom: 1px solid var(--border); }
.nav-inner { display: flex; align-items: center; justify-content: space-between;
             height: 66px; }
.logo { font-family: var(--serif); font-weight: 700; font-size: 1.5rem;
        letter-spacing: -0.02em; }
.nav-links { display: flex; gap: 1.6rem; align-items: center; font-family: var(--sans); }
.nav-links a { color: var(--muted); text-decoration: none; font-size: 0.92rem; }
.nav-links a:hover { color: var(--text); }
.toggle { background: var(--surface); border: 1px solid var(--border);
          color: var(--text); border-radius: 8px; padding: 0.4rem 0.8rem;
          cursor: pointer; font-size: 0.86rem; user-select: none; font-family: var(--sans); }
.toggle:hover { border-color: var(--accent); }

/* hero */
.hero { text-align: center; padding: 6rem 0 3rem; }
.eyebrow { display: inline-block; font-family: var(--sans); font-size: 0.74rem;
           letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent);
           border: 1px solid var(--border); border-radius: 999px;
           padding: 0.4rem 1rem; margin-bottom: 1.7rem; font-weight: 600; }
.hero h1 { font-size: clamp(2.7rem, 6vw, 4.4rem); line-height: 1.05;
           margin: 0 0 1.4rem; }
.hero .sub { font-size: 1.28rem; color: var(--muted); max-width: 40rem;
             margin: 0 auto 2.3rem; line-height: 1.55; }
.cta { display: flex; gap: 0.9rem; justify-content: center; flex-wrap: wrap;
       font-family: var(--sans); }
.btn { display: inline-block; padding: 0.8rem 1.55rem; border-radius: 9px;
       text-decoration: none; font-weight: 600; font-size: 0.98rem; }
.btn-primary { background: var(--accent); color: #fff8ef; border: 1px solid var(--accent); }
.btn-primary:hover { background: #741f2c; }
:root.dark .btn-primary { color: #23150f; }
.btn-ghost { border: 1px solid var(--border); color: var(--text); background: var(--surface); }
.btn-ghost:hover { border-color: var(--accent); }

/* code card (hero) */
.code-card { max-width: 640px; margin: 3.5rem auto 0; background: #1b1811;
             border: 1px solid #2e2820; border-radius: 13px; overflow: hidden;
             text-align: left; box-shadow: 0 18px 50px rgba(40, 24, 16, 0.22); }
.code-head { display: flex; gap: 0.5rem; align-items: center;
             padding: 0.8rem 1.1rem; border-bottom: 1px solid #2e2820; }
.dot { width: 11px; height: 11px; border-radius: 50%; background: #4a4033; }
.code-card pre, .demo-src pre { margin: 0; padding: 1.25rem 1.4rem;
             font-family: var(--mono); font-size: 0.82rem; line-height: 1.7;
             overflow-x: auto; max-width: 100%; color: #d8cfbf; }

/* Wit syntax tokens (set by the highlighter in script.wit) */
.tok-com   { color: #8a8069; font-style: italic; }
.tok-node  { color: #e0a24f; }
.tok-def   { color: #e394a4; }
.tok-fence { color: #6fbfa6; }
.tok-ctrl  { color: #c79ae0; }
.tok-interp{ color: #74c6b4; }
.tok-cap   { color: #a0c97e; }
.tok-kw    { color: #c79ae0; font-weight: 600; }
.tok-str   { color: #a0c97e; }

/* sections + features */
.section { padding: 5.5rem 0; }
.section h2 { text-align: center; font-size: clamp(2.1rem, 4vw, 2.8rem);
              margin: 0 0 1rem; }
.section h2::after { content: ""; display: block; width: 54px; height: 2px;
              margin: 0.9rem auto 0; background: var(--accent); opacity: 0.7; }
.section .lead { text-align: center; color: var(--muted); max-width: 40rem;
                 margin: 0 auto 3rem; font-size: 1.12rem; }
.grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.3rem; }
.feature { min-width: 0; background: var(--surface); border: 1px solid var(--border);
           border-radius: 12px; padding: 1.9rem;
           transition: transform .15s, border-color .15s, box-shadow .15s; }
.feature:hover { transform: translateY(-3px); border-color: var(--accent);
                 box-shadow: 0 12px 30px rgba(40, 24, 16, 0.09); }
.feature .ico { font-size: 1.8rem; margin-bottom: 0.85rem; }
.feature h3 { margin: 0 0 0.45rem; font-size: 1.28rem; }
.feature p, .feature > :not(.ico):not(h3):not(.hint):not(.card-detail) {
           margin: 0; color: var(--muted); font-size: 1rem; line-height: 1.5; }

/* stats band */
.stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem;
         text-align: center; border: 1px solid var(--border);
         border-radius: 16px; padding: 2.3rem 1rem; background: var(--surface); }
.stat .n { font-family: var(--serif); font-size: 2.4rem; font-weight: 700;
           letter-spacing: -0.02em; }
.stat .l { color: var(--muted); font-size: 0.86rem; font-family: var(--sans);
           text-transform: uppercase; letter-spacing: 0.06em; }

/* clickable summary cards + the full-width detail card spawned under the row */
.feature { cursor: pointer; position: relative; }
.feature .hint { margin-top: 1.1rem; font-size: 0.82rem; color: var(--accent);
                 font-weight: 600; font-family: var(--sans); }
.feature.active { border-color: var(--accent);
                  box-shadow: 0 10px 26px rgba(40, 24, 16, 0.10); }

.detail-card { grid-column: 1 / -1; display: none; background: var(--surface);
               border: 1px solid var(--accent); border-radius: 14px;
               padding: 1.9rem 2rem; box-shadow: 0 16px 40px rgba(40, 24, 16, 0.12); }
.detail-head { display: flex; align-items: baseline; justify-content: space-between;
               gap: 1rem; margin-bottom: 1.5rem; }
.detail-head h3 { margin: 0; font-size: 1.4rem; }
.detail-close { cursor: pointer; font-family: var(--sans); font-size: 0.8rem;
                color: var(--muted); border: 1px solid var(--border);
                border-radius: 8px; padding: 0.35rem 0.75rem; white-space: nowrap; }
.detail-close:hover { border-color: var(--accent); color: var(--accent); }

.demo { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 1.3rem 1.6rem; align-items: start; }
.demo-pane { min-width: 0; }
.demo-label { font-family: var(--sans); font-size: 0.72rem; text-transform: uppercase;
              letter-spacing: 0.09em; color: var(--muted); font-weight: 600;
              margin-bottom: 0.5rem; }
.demo-src { background: #1b1811; border: 1px solid #2e2820; border-radius: 10px;
            overflow: hidden; }
/* the "output preview" — a bright printed sheet, isolated from the theme */
.demo-out { background: #ffffff; color: #1a1f2e; border: 1px solid #e6e2d6;
            border-radius: 10px; padding: 1rem 1.15rem; font-family: var(--serif);
            font-size: 0.94rem; line-height: 1.55; overflow-x: auto;
            box-shadow: 0 6px 18px rgba(40, 24, 16, 0.08); }
.demo-out > :first-child { margin-top: 0; }
.demo-out > :last-child { margin-bottom: 0; }
.demo-out p { margin: 0 0 0.5em; }
.demo-out h2 { font-size: 1.2rem; font-weight: 700; text-align: left;
               margin: 0.3em 0 0.3em; color: #131826; }
.demo-out h2::after { content: none; }
.demo-out h3 { font-size: 1.05rem; margin: 0.3em 0 0.2em; color: #131826; }
.demo-out strong { font-weight: 700; }
.demo-out em { font-style: italic; }
.demo-out ul { margin: 0 0 0.5em; padding-left: 1.3em; }
.demo-out li { margin: 0.1em 0; }
.demo-out table { border-collapse: collapse; width: 100%; font-size: 0.86rem;
                  margin: 0; font-family: var(--sans); }
.demo-out th, .demo-out td { border: 1px solid #dde1ea; padding: 0.3rem 0.55rem;
                             text-align: left; }
.demo-out thead th { background: #f3f1ea; }
.demo-out .note { background: #f5efe6; border-left: 3px solid var(--accent);
                  padding: 0.6rem 0.85rem; border-radius: 6px; }
.demo-out .pill { background: var(--accent); color: #fff; padding: 0.15em 0.7em;
                  border-radius: 999px; font-size: 0.82em; font-weight: 600;
                  font-family: var(--sans); }
.demo-out .break { text-align: center; letter-spacing: 0.5em; color: #b9b3a5;
                   margin: 0.7em 0; }
.demo-out ol { margin: 0 0 0.5em; padding-left: 1.4em; }
.demo-vs { grid-column: 1 / -1; margin-top: 0.3rem; font-size: 0.86rem;
           color: var(--muted); font-family: var(--sans);
           border-left: 2px solid var(--border); padding-left: 0.7rem; }
.demo-vs strong { color: var(--accent); font-weight: 700; }

/* comprehensive examples — fold-out panels */
.examples { display: grid; gap: 1.2rem; }
.example { background: var(--surface); border: 1px solid var(--border);
           border-radius: 14px; overflow: hidden; transition: border-color .15s; }
.example.open { border-color: var(--accent); }
.example-head { display: flex; align-items: center; gap: 1rem;
                padding: 1.3rem 1.7rem; cursor: pointer; }
.example-head:hover { background: var(--surface-2); }
.example-title { font-family: var(--serif); font-size: 1.35rem; font-weight: 700;
                 flex: 1; min-width: 0; }
.example-badge { font-family: var(--sans); font-size: 0.7rem; text-transform: uppercase;
                 letter-spacing: 0.08em; color: var(--accent); border: 1px solid var(--border);
                 border-radius: 999px; padding: 0.28rem 0.72rem; white-space: nowrap; }
.example-toggle { font-family: var(--sans); font-size: 0.82rem; color: var(--muted);
                  white-space: nowrap; }
.example.open .example-toggle { color: var(--accent); }
.example-body { display: none; grid-template-columns: 1fr; gap: 1.3rem;
                padding: 0 1.7rem 1.8rem; }
.example.open .example-body { display: grid; }

/* footer */
.footer { border-top: 1px solid var(--border); padding: 3.5rem 0;
          color: var(--muted); text-align: center; font-size: 0.95rem; }
.footer a { text-decoration: none; color: var(--muted); }
.footer a:hover { color: var(--accent); }

@media (max-width: 760px) {
  body { font-size: 17px; }
  .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .demo { grid-template-columns: 1fr; }
  .nav-links a:not(.toggle) { display: none; }
}
style@@
stylesheet#
