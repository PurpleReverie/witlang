# Wit website deploy configuration.
# Copy to `.env` and adjust for your deployment. `.env` is gitignored.
# In CI/deploy you can set these as real environment variables instead.

# Canonical GitHub repository (used for every "GitHub" / "View source" link).
WIT_REPO_URL=https://github.com/PurpleReverie/witlang

# Brand + tagline shown in the chrome and <title>.
WIT_SITE_TITLE=Wit
WIT_SITE_TAGLINE=Write the paper. Not the preamble.

# Canonical base URL of the deployed site (optional; used for absolute links).
# e.g. https://witlang.org
WIT_SITE_URL=

# Runtime server (server.mjs under pm2 — `make deploy`). PORT the site listens
# on; HOST to bind (0.0.0.0 = all interfaces, 127.0.0.1 = localhost only).
PORT=8000
HOST=0.0.0.0
