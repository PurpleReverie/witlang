~ master.wit — a composition script that assembles the book from parts.
~ `reference` pulls in the definitions, data, and nodes from another file.
~ note: #book is data (a record) — the document body is wrapped in a
~ core-vocab @article so the wrapper never collides with the data name.

reference ./shared/schema.wit
reference ./shared/sources.wit
reference ./chapters/one.wit
reference ./chapters/two.wit

#book: {
  title - The Keeper
  subtitle - "Attention, Perception, and the Moral Life"
  author - Aldous Vane
  status - draft
}

@article
@header
@h1 @book.title h1@
@p @em @book.subtitle em@ p@
@p @book.author p@
@p @small Status — @book.status small@ p@
header@

@chapter_one chapter_one@
@chapter_two chapter_two@
article@
