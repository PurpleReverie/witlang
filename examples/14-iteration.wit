~ (each @collection as item) ... (end)
~ the loop walks static data — no iteration state, no mutation, no surprises.
~ note: a data def and the loop that follows it are separated by a blank line.

#findings: [
  { claim - Attention precedes perception, strength - strong }
  { claim - Looking is never neutral, strength - moderate }
  { claim - Attention is a form of labour, strength - strong }
]

@ul
(each @findings as finding)
@li @finding.claim — @em @finding.strength em@ li@
(end)
ul@

~ iteration is what makes a Wit document self-organising —
~ define the chapters as data, and the table of contents and the
~ chapter headings both render from that one source.

#chapters: [
  { number - I, title - The Lamp }
  { number - II, title - The Voice }
  { number - III, title - The Stranger }
]

~ the table of contents —

@nav
@ul
(each @chapters as ch)
@li @ch.number — @ch.title li@
(end)
ul@
nav@

~ — and the chapter headings, from the same list.

(each @chapters as ch)
@h3 @ch.number — @ch.title h3@
(end)
