{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Wit",
  "scopeName": "source.wit",
  "fileTypes": ["wit"],
  "patterns": [
    { "include": "#block-comment" },
    { "include": "#line-comment" },
    { "include": "#reference" },
    { "include": "#form-field" },
    { "include": "#script-block" },
    { "include": "#raw-frozen" },
    { "include": "#raw-style" },
    { "include": "#raw-script" },
    { "include": "#raw-node" },
    { "include": "#paren-statement" },
    { "include": "#value-block-terminator" },
    { "include": "#capture-list" },
    { "include": "#interpolation" },
    { "include": "#capture-interp" },
    { "include": "#additive-def" },
    { "include": "#node-def-open" },
    { "include": "#node-def-close" },
    { "include": "#node-open" },
    { "include": "#node-close" },
    { "include": "#pipe-param" },
    { "include": "#bold" },
    { "include": "#italic" }
  ],
  "repository": {
    "line-comment": {
      "match": "^\\s*~ .*$",
      "name": "comment.line.tilde.wit"
    },
    "block-comment": {
      "begin": "~~",
      "end": "~~/",
      "name": "comment.block.wit"
    },
    "reference": {
      "comment": "reference ./other.wit — cross-file include directive",
      "match": "^\\s*(reference)\\s+(.+)$",
      "captures": {
        "1": { "name": "keyword.control.import.wit" },
        "2": { "name": "string.unquoted.path.wit" }
      }
    },
    "form-field": {
      "comment": "key: value — a form-fill / value-block body field (indented)",
      "match": "^(\\s+)([A-Za-z0-9_-]+)(:)(?=\\s)",
      "captures": {
        "2": { "name": "entity.other.attribute-name.wit" },
        "3": { "name": "punctuation.separator.key-value.wit" }
      }
    },
    "script-block": {
      "begin": "<%",
      "end": "%>",
      "name": "meta.embedded.javascript.wit",
      "patterns": [
        { "include": "source.js" }
      ]
    },
    "interpolation": {
      "comment": "{{ path }} — the one active substitution inside @@ bodies/strings",
      "match": "\\{\\{\\s*[A-Za-z0-9_.-]+\\s*\\}\\}",
      "name": "variable.other.interpolation.wit"
    },
    "capture-interp": {
      "comment": "::name:: — capture interpolation inside a def body",
      "match": "(::)([A-Za-z0-9_-]+)(::)",
      "captures": {
        "1": { "name": "punctuation.definition.interpolation.wit" },
        "2": { "name": "variable.other.interpolation.wit" },
        "3": { "name": "punctuation.definition.interpolation.wit" }
      }
    },
    "capture-list": {
      "comment": "||a, b, c|| — capture (parameter) declarations on a def",
      "begin": "\\|\\|",
      "end": "\\|\\|",
      "beginCaptures": { "0": { "name": "punctuation.definition.capture.wit" } },
      "endCaptures": { "0": { "name": "punctuation.definition.capture.wit" } },
      "patterns": [
        { "match": "[A-Za-z0-9_-]+", "name": "variable.parameter.wit" }
      ]
    },
    "pipe-param": {
      "comment": "|key value| — a param slot; the key reads as an attribute",
      "begin": "\\|(?!\\|)",
      "end": "\\|",
      "beginCaptures": { "0": { "name": "punctuation.definition.param.wit" } },
      "endCaptures": { "0": { "name": "punctuation.definition.param.wit" } },
      "patterns": [
        {
          "match": "\\G\\s*([A-Za-z0-9_-]+)",
          "captures": { "1": { "name": "entity.other.attribute-name.wit" } }
        },
        { "include": "#capture-interp" }
      ]
    },
    "raw-frozen": {
      "comment": "@@@name ... name@@@ — fully verbatim; {{...}} NOT interpolated",
      "begin": "@@@[A-Za-z0-9_-]+",
      "end": "[A-Za-z0-9_-]+@@@",
      "beginCaptures": { "0": { "name": "entity.name.tag.wit" } },
      "endCaptures": { "0": { "name": "entity.name.tag.wit" } },
      "name": "meta.raw.frozen.wit",
      "contentName": "string.unquoted.raw.wit"
    },
    "raw-style": {
      "comment": "@@style ... style@@ — literal CSS body, {{...}} live",
      "begin": "@@style\\b",
      "end": "style@@",
      "beginCaptures": { "0": { "name": "entity.name.tag.wit" } },
      "endCaptures": { "0": { "name": "entity.name.tag.wit" } },
      "name": "meta.embedded.block.css.wit",
      "patterns": [
        { "include": "#interpolation" },
        { "include": "source.css" }
      ]
    },
    "raw-script": {
      "comment": "@@script ... script@@ — literal JS body, {{...}} live",
      "begin": "@@script\\b",
      "end": "script@@",
      "beginCaptures": { "0": { "name": "entity.name.tag.wit" } },
      "endCaptures": { "0": { "name": "entity.name.tag.wit" } },
      "name": "meta.embedded.block.js.wit",
      "patterns": [
        { "include": "#interpolation" },
        { "include": "source.js" }
      ]
    },
    "raw-node": {
      "comment": "@@name ... name@@ — generic literal node; body inert but {{...}} live",
      "begin": "@@[A-Za-z0-9_-]+",
      "end": "[A-Za-z0-9_-]+@@",
      "beginCaptures": { "0": { "name": "entity.name.tag.wit" } },
      "endCaptures": { "0": { "name": "entity.name.tag.wit" } },
      "name": "meta.raw.wit",
      "contentName": "string.unquoted.raw.wit",
      "patterns": [
        { "include": "#interpolation" }
      ]
    },
    "value-block-terminator": {
      "match": "!!",
      "name": "punctuation.terminator.value-block.wit"
    },
    "additive-def": {
      "match": "\\+#[A-Za-z0-9_-]+",
      "name": "entity.name.function.partial.wit"
    },
    "node-def-open": {
      "match": "#[A-Za-z0-9_-]+",
      "name": "entity.name.function.wit"
    },
    "node-def-close": {
      "match": "[A-Za-z0-9_-]+#",
      "name": "entity.name.function.wit"
    },
    "node-open": {
      "match": "@[A-Za-z0-9_-]+",
      "name": "entity.name.tag.wit"
    },
    "node-close": {
      "match": "[A-Za-z0-9_-]+@",
      "name": "entity.name.tag.wit"
    },
    "paren-statement": {
      "comment": "(if …)/(each …) statements AND (key value) node params",
      "begin": "\\(",
      "end": "\\)",
      "patterns": [
        {
          "match": "\\b(if|else|end|each|as|is|equals)\\b",
          "name": "keyword.control.wit"
        },
        {
          "comment": "first identifier after ( is a param key, e.g. @div(class x)",
          "match": "(?<=\\()([A-Za-z0-9_-]+)",
          "name": "entity.other.attribute-name.wit"
        },
        { "include": "#node-open" },
        { "include": "#capture-interp" }
      ]
    },
    "italic": {
      "match": "_[^_\\n]+_",
      "name": "markup.italic.wit"
    },
    "bold": {
      "match": "\\*[^*\\n]+\\*",
      "name": "markup.bold.wit"
    }
  }
}
