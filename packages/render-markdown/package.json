{
  "name": "@witlang/render-markdown",
  "version": "0.2.1",
  "description": "Markdown renderer for the Wit markup language",
  "keywords": [
    "wit",
    "markup",
    "markdown",
    "renderer"
  ],
  "license": "MIT",
  "author": "Tauraj Greig",
  "repository": {
    "type": "git",
    "url": "https://github.com/PurpleReverie/witlang.git",
    "directory": "packages/render-markdown"
  },
  "homepage": "https://github.com/PurpleReverie/witlang#readme",
  "bugs": "https://github.com/PurpleReverie/witlang/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
